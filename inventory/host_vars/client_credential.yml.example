---
# Copy to solaris.yml and fill in, then encrypt:
#   cp solaris.yml.example solaris.yml
#   ansible-vault encrypt inventory/host_vars/solaris.yml
#
# First bootstrap may use root; afterwards ansible_user is develer (sudo).
ansible_ssh_pass:    "CHANGE_ME_SSH_PASSWORD"
ansible_become_pass: "CHANGE_ME_DEVELER_SUDO_PASSWORD"
develer_password:    "CHANGE_ME_DEVELER_PASSWORD"
collaudo_password:   "CHANGE_ME_COLLAUDO_PASSWORD"

# Optional: checkout repo as collaudo (SSH). Leave bench_git_repo_url empty to skip.
# Use the Host alias in the URL so ~/.ssh/config selects the key:
#   git@nome_repo:org/repo.git
bench_git_repo_url: "git@nome_repo:org/repo.git"
bench_git_ssh_host: "nome_repo"
bench_git_ssh_hostname: "github.com"
# bench_git_ssh_user: git
bench_git_dest: "/home/collaudo/src/repo"
# bench_git_version: main
