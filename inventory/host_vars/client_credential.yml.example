---
# Copy to solaris.yml and fill in, then encrypt:
#   cp solaris.yml.example solaris.yml
#   ansible-vault encrypt inventory/host_vars/solaris.yml
#
# First bootstrap may use root; afterwards ansible_user is develer (sudo).
ansible_ssh_pass:    "CHANGE_ME_SSH_PASSWORD"
ansible_become_pass: "CHANGE_ME_DEVELER_SUDO_PASSWORD"
develer_password:    "CHANGE_ME_DEVELER_PASSWORD"
collaudo_password:   "CHANGE_ME_COLLAUDO_PASSWORD"

# Optional: per-host git checkouts as collaudo (SSH).
# Put this list in inventory/host_vars/<hostname>.yml (not in the role defaults).
# Each entry runs checkout_repo.yml. Use the Host alias in repo_url.
bench_git_repos:
  - repo_url: "git@electronic_keystop_collaudo:develersrl/electronic_keystop_collaudo.git"
    ssh_host: "electronic_keystop_collaudo"
    ssh_hostname: "github.com"
    dest: "/home/collaudo/src/electronic_keystop_collaudo"
    version: main
