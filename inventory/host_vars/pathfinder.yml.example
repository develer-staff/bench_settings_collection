---
# Copy to pathfinder.yml and fill in, then encrypt:
#   cp pathfinder.yml.example pathfinder.yml
#   ansible-vault encrypt inventory/host_vars/pathfinder.yml
#
# First bootstrap may use root; afterwards ansible_user is develer (sudo).
ansible_ssh_pass: "CHANGE_ME_SSH_PASSWORD"
ansible_become_pass: "CHANGE_ME_DEVELER_SUDO_PASSWORD"
develer_password: "CHANGE_ME_DEVELER_PASSWORD"
collaudo_password: "CHANGE_ME_COLLAUDO_PASSWORD"
